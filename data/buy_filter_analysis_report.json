{
  "flow": {
    "pipeline": [
      "1. areru_engine / build_predictions: 本命・勝率・適正オッズ・相対ランク・買い目候補を生成",
      "2. apply_expected_value / score_horse_ev: 補正勝率と期待値(EV)を算出",
      "3. apply_ev_rank_and_labels: レース信頼度→暫定S/A/B、decide_buy_skipで暫定買い",
      "4. finalize_prediction_records → tighten_buy_selection: 最終S/A割当＋買いキャップ",
      "5. 表示時 web_app._apply_rank_and_buy: tighten再適用、買いのみ本命軸チケット再生成"
    ],
    "provisional_buy_gates_decide_buy_skip": {
      "EV": ">=100",
      "AI信頼度": ">=58",
      "レース信頼度": ">=58",
      "再現率": ">=40",
      "能力差": ">=65 (BUY_ABILITY_FLOOR; 能力差≥80とは別)",
      "本命オッズ": "<=50 or missing"
    },
    "final_buy_gates_tighten": {
      "rank": "S or A only",
      "same_gates_as_provisional": true,
      "cap": "JRA: day slots S+A相当 / NAR: venue slots (2-4)",
      "sort": "_buy_score (ability-weighted)"
    },
    "ticket_generation": {
      "note": "投資判定=買いのレースに対し本命軸の単勝/馬連/ワイド等を生成。見送りは買い目を出さない/弱める",
      "important": "ランク判定と買い判定は別。買い目の広さは買い判定ゲート自体には未使用"
    },
    "not_used_in_buy_gate": [
      "複勝オッズ",
      "ワイド/馬連の合成オッズ",
      "能力差≥80 (under_validation)",
      "S/A/B条件の追加最適化（停止中）"
    ]
  },
